rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isActiveAdminDocument() {
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.emailVerified == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status in ['active', 'approved'];
    }

    function isAdmin() {
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && (
          isActiveAdminDocument() ||
          ('email' in request.auth.token &&
           request.auth.token.email in ['moamen.elsayed.abdelmoamen@gmail.com', 'admin@elbatalexpress.com'])
        );
    }

    function isCaptainAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/captains/$(request.auth.uid));
    }

    // Canonical approval gate matching Cloud Functions and Android client.
    // Preserves legacy active captains lacking explicit accountStatus/isApproved fields.
    function isApprovedCaptainDoc(data) {
      return data != null
        && (
          ('accountType' in data && data.accountType == 'captain') ||
          (!('accountType' in data) && 'role' in data && data.role == 'captain')
        )
        && (!('isBlocked' in data) || data.isBlocked != true)
        && (!('isSuspended' in data) || data.isSuspended != true)
        && (!('isApproved' in data) || data.isApproved == true)
        && (
          ('accountStatus' in data && data.accountStatus == 'approved') ||
          (
            !('accountStatus' in data) &&
            (
              ('status' in data && data.status in ['active', 'approved', 'online', 'available', 'busy']) ||
              (!('status' in data) && 'isApproved' in data && data.isApproved == true)
            )
          )
        );
    }

    function isApprovedCaptainAccount() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/captains/$(request.auth.uid))
        && isApprovedCaptainDoc(get(/databases/$(database)/documents/captains/$(request.auth.uid)).data);
    }

    function isMerchantDoc(data) {
      return data != null && 'accountType' in data && data.accountType == 'merchant';
    }

    function isMerchantAccount() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
        && isMerchantDoc(get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data);
    }

    function isOptionalBoundedString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    // --- 1. Captains Validation & Rules ---
    // Uses `let` bindings and strict key allowlists so evaluation stays well below
    // Firestore's 1,000-expression limit while blocking privilege, financial, and cross-captain tampering.
    function isValidCaptainStorageOrEmptyPath(val, expectedUid, maxLen) {
      return val == null || (
        val is string &&
        val.size() <= maxLen &&
        (val == '' || val.matches('^captains/' + expectedUid + '/(profile|documents)/[a-zA-Z0-9_\\.\\-]+$'))
      );
    }

    function isValidNewCaptainSelfProfile(captainId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'uid', 'name', 'fullName', 'driver_name', 'email', 'phone', 'phoneNumber',
          'address', 'vehicleType', 'licensePlate',
          'avatarUri', 'avatarPresetIndex', 'personalImage', 'idCardFront', 'idCardBack',
          'profileImagePath', 'idFrontImagePath', 'idBackImagePath', 'licenseImagePath',
          'idDocumentsComplete', 'accountType', 'role', 'status',
          'accountStatus', 'isApproved',
          'emailVerified', 'isEmailVerified',
          'availabilityStatus', 'presenceStatus', 'shiftStatus',
          'isOnline', 'isLoggedIn', 'fcmToken',
          'totalOrdersCount', 'walletBalance', 'rating',
          'createdAt', 'updatedAt'
        ])
        && ('uid' in d) && d.uid == captainId
        && ('accountType' in d) && d.accountType == 'captain'
        && (!('role' in d) || d.role == 'captain')
        && ('accountStatus' in d) && d.accountStatus == 'pending'
        && ('isApproved' in d) && d.isApproved == false
        && ('status' in d) && d.status == 'pending'
        && ('createdAt' in d) && d.createdAt is timestamp
        && (!('walletBalance' in d) || (d.walletBalance is number && d.walletBalance == 0))
        && (!('totalOrdersCount' in d) || (d.totalOrdersCount is int && d.totalOrdersCount == 0))
        && (!('rating' in d) || (d.rating is number && d.rating == 5.0))
        && (!('emailVerified' in d) || d.emailVerified == false || ('email_verified' in request.auth.token && request.auth.token.email_verified == true))
        && (!('isEmailVerified' in d) || d.isEmailVerified == false || ('email_verified' in request.auth.token && request.auth.token.email_verified == true))
        && (!('name' in d) || (d.name is string && d.name.size() <= 120))
        && (!('fullName' in d) || (d.fullName is string && d.fullName.size() <= 120))
        && (!('email' in d) || (d.email is string && d.email.size() <= 160))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 32))
        && (!('phoneNumber' in d) || (d.phoneNumber is string && d.phoneNumber.size() <= 32))
        && (!('address' in d) || (d.address is string && d.address.size() <= 300))
        && (!('vehicleType' in d) || (d.vehicleType is string && d.vehicleType.size() <= 80))
        && (!('licensePlate' in d) || (d.licensePlate is string && d.licensePlate.size() <= 40))
        && (!('profileImagePath' in d) || isValidCaptainStorageOrEmptyPath(d.profileImagePath, captainId, 300))
        && (!('idFrontImagePath' in d) || isValidCaptainStorageOrEmptyPath(d.idFrontImagePath, captainId, 300))
        && (!('idBackImagePath' in d) || isValidCaptainStorageOrEmptyPath(d.idBackImagePath, captainId, 300))
        && (!('licenseImagePath' in d) || isValidCaptainStorageOrEmptyPath(d.licenseImagePath, captainId, 300))
        && (!('personalImage' in d) || isValidCaptainStorageOrEmptyPath(d.personalImage, captainId, 500))
        && (!('idCardFront' in d) || isValidCaptainStorageOrEmptyPath(d.idCardFront, captainId, 500))
        && (!('idCardBack' in d) || isValidCaptainStorageOrEmptyPath(d.idCardBack, captainId, 500))
        && (!('avatarUri' in d) || isValidCaptainStorageOrEmptyPath(d.avatarUri, captainId, 500))
        && (!('isOnline' in d) || d.isOnline == false)
        && (!('isLoggedIn' in d) || d.isLoggedIn == false)
        && (!('idDocumentsComplete' in d) || d.idDocumentsComplete is bool);
    }

    // Strict allowlist of non-sensitive operational & Storage path fields a captain can update on their own profile.
    // Explicitly EXCLUDES accountType, accountStatus, isApproved, rejectionReason, approvedAt, approvedBy,
    // walletBalance, totalOrdersCount, rating, role, status, subscriptions, and activeMerchantId.
    function isValidCaptainSelfUpdate(captainId) {
      let d = request.resource.data;
      let old = resource.data;
      let changed = d.diff(old).affectedKeys();
      let approved = isApprovedCaptainDoc(old);
      return (
          ('accountType' in old && old.accountType == 'captain') ||
          (!('accountType' in old) && 'role' in old && old.role == 'captain')
        )
        && changed.hasOnly([
          'name', 'fullName', 'driver_name',
          'phone', 'phoneNumber', 'address',
          'vehicleType', 'licensePlate',
          'avatarUri', 'avatarPresetIndex',
          'personalImage', 'idCardFront', 'idCardBack',
          'profileImagePath', 'profileImageUpdatedAt',
          'idFrontImagePath', 'idFrontUploadedAt',
          'idBackImagePath', 'idBackUploadedAt',
          'licenseImagePath', 'licenseImageUpdatedAt',
          'idDocumentsComplete',
          'location', 'latitude', 'longitude', 'accuracy', 'bearing', 'speed',
          'lastLocationUpdate', 'lastLocationTimestamp',
          'presenceStatus', 'availabilityStatus', 'shiftStatus',
          'isOnline', 'isLoggedIn',
          'emailVerified', 'isEmailVerified',
          'fcmToken', 'updatedAt'
        ])
        && (!('isOnline' in changed) || d.isOnline == false || (d.isOnline == true && approved))
        && (!('isLoggedIn' in changed) || d.isLoggedIn == false || (d.isLoggedIn == true && approved))
        && (!('presenceStatus' in changed) || d.presenceStatus == 'offline' || approved)
        && (!('availabilityStatus' in changed) || d.availabilityStatus == 'offline' || approved)
        && (!changed.hasAny(['location', 'latitude', 'longitude', 'accuracy', 'bearing', 'speed', 'lastLocationUpdate', 'lastLocationTimestamp', 'shiftStatus']) || approved)
        && (!('emailVerified' in changed) || d.emailVerified == false || ('email_verified' in request.auth.token && request.auth.token.email_verified == true))
        && (!('isEmailVerified' in changed) || d.isEmailVerified == false || ('email_verified' in request.auth.token && request.auth.token.email_verified == true))
        && (!('name' in changed) || (d.name is string && d.name.size() <= 120))
        && (!('fullName' in changed) || (d.fullName is string && d.fullName.size() <= 120))
        && (!('phone' in changed) || (d.phone is string && d.phone.size() <= 32))
        && (!('phoneNumber' in changed) || (d.phoneNumber is string && d.phoneNumber.size() <= 32))
        && (!('profileImagePath' in changed) || isValidCaptainStorageOrEmptyPath(d.profileImagePath, captainId, 300))
        && (!('idFrontImagePath' in changed) || isValidCaptainStorageOrEmptyPath(d.idFrontImagePath, captainId, 300))
        && (!('idBackImagePath' in changed) || isValidCaptainStorageOrEmptyPath(d.idBackImagePath, captainId, 300))
        && (!('licenseImagePath' in changed) || isValidCaptainStorageOrEmptyPath(d.licenseImagePath, captainId, 300))
        && (!('personalImage' in changed) || isValidCaptainStorageOrEmptyPath(d.personalImage, captainId, 500))
        && (!('idCardFront' in changed) || isValidCaptainStorageOrEmptyPath(d.idCardFront, captainId, 500))
        && (!('idCardBack' in changed) || isValidCaptainStorageOrEmptyPath(d.idCardBack, captainId, 500))
        && (!('avatarUri' in changed) || isValidCaptainStorageOrEmptyPath(d.avatarUri, captainId, 500));
    }

    match /captains/{captainId} {
      // A merchant can read only the currently assigned captain's live profile.
      allow get: if isSignedIn() && isValidId(captainId) && (
        request.auth.uid == captainId ||
        isAdmin() ||
        (isMerchantAccount() && (
          ('activeMerchantId' in existing() && existing().activeMerchantId == request.auth.uid) ||
          ('currentMerchantId' in existing() && existing().currentMerchantId == request.auth.uid)
        ))
      );

      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(captainId)
        && (
          isAdmin() ||
          (
            request.auth.uid == captainId
            && !isMerchantAccount()
            && isValidNewCaptainSelfProfile(captainId)
          )
        );

      allow update: if isSignedIn()
        && isValidId(captainId)
        && (
          isAdmin() ||
          (
            request.auth.uid == captainId
            && isValidCaptainSelfUpdate(captainId)
          )
        );

      allow delete: if isAdmin();

      // Financial & wallet subcollections: strictly read-only for owning approved captain; written ONLY by Server / Admin
      match /transactions/{txId} {
        allow get, list: if isSignedIn() && (isAdmin() || (request.auth.uid == captainId && isApprovedCaptainAccount()));
        allow create, update, delete: if isAdmin();
      }

      match /daily_wallets/{dayKey} {
        allow get, list: if isSignedIn() && (isAdmin() || (request.auth.uid == captainId && isApprovedCaptainAccount()));
        allow create, update, delete: if isAdmin();
      }

      match /subscriptions/{subId} {
        allow get, list: if isSignedIn() && (isAdmin() || (request.auth.uid == captainId && isApprovedCaptainAccount()));
        allow create, update, delete: if isAdmin();
      }

      match /shifts/{shiftId} {
        allow get, list: if isSignedIn() && (isAdmin() || (request.auth.uid == captainId && isApprovedCaptainAccount()));
        allow create, update, delete: if isAdmin();
      }
    }

    // Legacy 'drivers' collection is strictly locked down to Admin writes; Captain App uses 'captains' exclusively.
    match /drivers/{driverId} {
      allow get: if isSignedIn() && isValidId(driverId) && (
        request.auth.uid == driverId ||
        isAdmin()
      );

      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- 2. Users (Customers) Collection ---
    // Isolated per user; blocks self-assigned roles, admin flags, wallet tampering, and cross-user PII scraping.
    function isValidCustomerUserDoc(data) {
      return isOptionalBoundedString(data, 'name', 120)
        && isOptionalBoundedString(data, 'fullName', 120)
        && isOptionalBoundedString(data, 'email', 160)
        && isOptionalBoundedString(data, 'phone', 32)
        && isOptionalBoundedString(data, 'address', 300)
        && (!('role' in data) || data.role == 'customer' || data.role == 'user')
        && !('isAdmin' in data)
        && !('walletBalance' in data);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && (
          isAdmin() ||
          (request.auth.uid == userId && isValidCustomerUserDoc(incoming()))
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && isValidCustomerUserDoc(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'fullName', 'phone', 'address', 'fcmToken', 'updatedAt'
            ])
          )
        );

      allow delete: if isAdmin();
    }

    // --- 3. Merchants Collection (canonical account store; restaurants is retired) ---
    function isValidMerchantDoc(data, merchantId) {
      return ('uid' in data) && data.uid == merchantId
        && ('accountType' in data) && data.accountType == 'merchant'
        && ('role' in data) && data.role == 'merchant'
        && ('name' in data) && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && ('email' in data) && data.email is string && data.email.size() <= 160
        && isOptionalBoundedString(data, 'phone', 32)
        && isOptionalBoundedString(data, 'address', 300)
        && isOptionalBoundedString(data, 'category', 80)
        && isOptionalBoundedString(data, 'logo', 1000)
        && isOptionalBoundedString(data, 'photoUrl', 1000)
        && isOptionalBoundedString(data, 'logoUrl', 1000)
        && isOptionalBoundedString(data, 'storagePath', 500);
    }

    function isSafeInitialMerchantDoc(data, merchantId) {
      return isValidMerchantDoc(data, merchantId)
        && data.email == request.auth.token.email
        && data.status == 'pending'
        && data.subscriptionStatus == 'unsubscribed'
        && data.isSubscribed == false
        && data.maxCaptains == 0
        && data.planId == 0
        && data.emailVerified == false
        && !('isApproved' in data)
        && !('isAdmin' in data)
        && !('walletBalance' in data)
        && !('subscription' in data)
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'address', 'category', 'logo', 'photoUrl',
          'logoUrl', 'storagePath', 'accountType', 'role', 'emailVerified', 'status',
          'isSubscribed', 'subscriptionStatus', 'maxCaptains', 'planId', 'authProvider',
          'createdAt', 'updatedAt'
        ]);
    }

    function isAllowedMerchantSelfUpdateKeys() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'name', 'phone', 'address', 'category', 'description', 'logo', 'logoUrl',
        'photoUrl', 'imageUrl', 'storagePath', 'location', 'latitude', 'longitude',
        'locationUrl', 'locationLink', 'mapUrl', 'mapLink', 'mapsUrl', 'mapsLink',
        'googleMapsUrl', 'googleMapUrl', 'isOpen', 'workingHours', 'fcmToken',
        'emailVerified', 'lastLoginAt', 'updatedAt'
      ]);
    }

    match /merchants/{merchantId} {
      allow get: if isSignedIn() && isValidId(merchantId)
        && (request.auth.uid == merchantId || isAdmin());
      allow list: if isAdmin();

    allow create: if isAdmin() || (
  isSignedIn()
  && isValidId(merchantId)
  && request.auth.uid == merchantId
  && isSafeInitialMerchantDoc(incoming(), merchantId)
);
      allow update: if isSignedIn()
        && isValidId(merchantId)
        && (
          isAdmin() ||
          (
            request.auth.uid == merchantId
            && isMerchantAccount()
            && isValidMerchantDoc(incoming(), merchantId)
            && isAllowedMerchantSelfUpdateKeys()
            && (!('emailVerified' in incoming().diff(existing()).affectedKeys())
              || incoming().emailVerified == false
              || request.auth.token.email_verified == true)
          )
        );

      // Merchant notifications are server-created; owners may read them and mark them read only.
      match /notifications/{notificationId} {
        allow get, list: if isSignedIn() && (request.auth.uid == merchantId || isAdmin());
        allow update: if isSignedIn()
          && request.auth.uid == merchantId
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          && incoming().isRead == true;
        allow create, delete: if false;
      }

      allow delete: if isAdmin();
    }

    // --- 4. Admins Collection ---
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Strictly managed via Firebase Admin SDK / Console
    }

    // --- 5. Orders Collection (Server-Authoritative Only) ---
    // - NO public or blanket authenticated reads.
    // - Captains read ONLY their own assigned orders or the single offer addressed to their UID.
    // - Merchants read ONLY orders belonging to their own store.
    // - Customers read ONLY their own orders.
    // - ZERO client writes by captains or regular users; all order mutations go exclusively through Cloud Functions (Admin SDK).
    function isOrderAssignedOrOfferedToCaptain(data) {
      return ('captainId' in data && data.captainId == request.auth.uid) ||
             ('driverId' in data && data.driverId == request.auth.uid) ||
             ('captainUid' in data && data.captainUid == request.auth.uid) ||
             ('assignedCaptainId' in data && data.assignedCaptainId == request.auth.uid) ||
             ('offeredCaptainId' in data && data.offeredCaptainId == request.auth.uid);
    }

    function isAvailablePendingOrder(data) {
      // An order offer is private to the single captain selected by the server.
      // eligibleCaptainIds is never an authorization source because it reveals other captains.
      return ('status' in data && data.status == 'pending')
        && ('offeredCaptainId' in data && data.offeredCaptainId == request.auth.uid);
    }

    function isOrderOwnedByMerchant(data) {
      return isMerchantAccount() && (
        ('merchantId' in data && data.merchantId == request.auth.uid) ||
        ('storeId' in data && data.storeId == request.auth.uid) ||
        ('vendorId' in data && data.vendorId == request.auth.uid) ||
        ('ownerId' in data && data.ownerId == request.auth.uid) ||
        ('userId' in data && data.userId == request.auth.uid)
      );
    }

    function isOrderOwnedByCustomer(data) {
      return ('customerId' in data && data.customerId == request.auth.uid);
    }

    function canReadOrder(data) {
      return isAdmin() ||
             (isApprovedCaptainAccount() && (isOrderAssignedOrOfferedToCaptain(data) || isAvailablePendingOrder(data))) ||
             isOrderOwnedByMerchant(data) ||
             isOrderOwnedByCustomer(data);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && canReadOrder(existing());
      allow list: if isSignedIn() && canReadOrder(existing());

      // Order creation, assignment, status changes, and financial transitions are server-only.
      // Admin SDK Cloud Functions bypass these client rules.
      allow create: if isAdmin();

      // Merchants may edit only non-financial details before assignment.
      // They cannot change status or confirm/reject a captain's submitted delivery data here;
      // those transitions must call merchantConfirmOrder / merchantCancelOrder.
      allow update: if isAdmin() || (
        isOrderOwnedByMerchant(existing())
        && incoming().merchantId == existing().merchantId
        && incoming().userId == existing().userId
        && incoming().orderCode == existing().orderCode
        && incoming().captainId == existing().captainId
        && !incoming().diff(existing()).affectedKeys().hasAny([
          'captainId', 'captainUid', 'driverId', 'assignedCaptainId',
          'offeredCaptainId', 'eligibleCaptainIds', 'excludedCaptainIds',
          'timedOutCaptainIds', 'dispatchStatus', 'assignedAt', 'acceptedAt',
          'deliveredAt', 'completedAt', 'captainEarning', 'captainEarnings',
          'platformCommission', 'walletCredited', 'settlementStatus', 'paymentStatus',
          'status', 'orderStatus', 'status_ar', 'customerDetailsConfirmed',
          'customerDetailsRejected', 'merchantConfirmed', 'confirmedAt',
          'merchantConfirmedAt', 'merchantRejectedAt', 'rejectionReason',
          'cancelledAt', 'cancelReason', 'deliveryFee', 'delivery_fee',
          'serviceFee', 'price', 'totalAmount'
        ])
      );
      allow delete: if isAdmin();
    }

    // Subscription records are read by their owner; only Admin SDK/Admin can mutate them.
    match /subscriptions/{subscriptionId} {
      allow get, list: if isAdmin() || (isMerchantAccount() && (
        subscriptionId == request.auth.uid ||
        ('merchantId' in existing() && existing().merchantId == request.auth.uid)
      ));
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get, list: if isAdmin() || (isMerchantAccount() && existing().merchantId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /order_codes/{code} {
      allow get: if isAdmin() || (
        isMerchantAccount() && existing().merchantId == request.auth.uid
      );
      allow list: if isAdmin() || (
        isMerchantAccount() && existing().merchantId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    match /idempotency_keys/{keyId} {
      allow get: if isAdmin() || (isMerchantAccount() && (
        !exists(/databases/$(database)/documents/idempotency_keys/$(keyId)) ||
        existing().merchantId == request.auth.uid
      ));
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Subscription requests are created/updated only by authenticated callable Cloud Functions.
    match /manual_subscription_requests/{requestId} {
      allow get, list: if isAdmin() || (
        isMerchantAccount() &&
        ('merchantId' in existing() && existing().merchantId == request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    match /settings/{settingId} {
      // Only the public Vodafone Cash/plan configuration is readable by signed-in merchants.
      allow read: if isAdmin() || (isSignedIn() && settingId in ['subscription_config', 'manual_subscription_config']);
      allow write: if false;
    }

    match /operation_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- 6. Captain Schedules & Shifts (Read-Only for Owning Approved Captain, Admin-Managed) ---
    match /captain_schedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId) && (
        isAdmin() ||
        (isApprovedCaptainAccount() && (
          scheduleId == request.auth.uid ||
          (existing() != null && (
            ('captainId' in existing() && existing().captainId == request.auth.uid) ||
            ('captainUid' in existing() && existing().captainUid == request.auth.uid) ||
            ('driverId' in existing() && existing().driverId == request.auth.uid)
          ))
        ))
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (isApprovedCaptainAccount() && (
          ('captainId' in existing() && existing().captainId == request.auth.uid) ||
          ('captainUid' in existing() && existing().captainUid == request.auth.uid) ||
          ('driverId' in existing() && existing().driverId == request.auth.uid)
        ))
      );

      allow create, update, delete: if isAdmin();

      match /shifts/{shiftId} {
        allow get, list: if isSignedIn() && (isAdmin() || (scheduleId == request.auth.uid && isApprovedCaptainAccount()));
        allow create, update, delete: if isAdmin();
      }
    }

    match /shifts/{shiftId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        (isApprovedCaptainAccount() && (
          ('captainId' in existing() && existing().captainId == request.auth.uid) ||
          ('driverId' in existing() && existing().driverId == request.auth.uid) ||
          ('captainUid' in existing() && existing().captainUid == request.auth.uid)
        ))
      );
      allow create, update, delete: if isAdmin();
    }
  }
}
